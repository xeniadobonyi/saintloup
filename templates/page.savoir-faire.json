ius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":80,"padding-block-end":80}},"section_4wnUGf":{"type":"section","blocks":{"image_dtQ7Kb":{"type":"image","name":"t:names.image","settings":{"image":"shopify:\/\/shop_images\/murier.png","link":"","image_ratio":"adapt","width":"fit-content","custom_width":100,"width_mobile":"fit-content","custom_width_mobile":100,"height":"fit","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_NRNmFm":{"type":"text","name":"t:names.text","settings":{"text":"<h2>1. Cultiver les mûriers<\/h2><p>Le ver à soie se nourrit exclusivement de feuilles de mûriers blancs. Il les aime tellement que son surnom, \"magnan\", signifie \"goinfre\" en occitan. Les mûriers de la soie SAINT LOUP, localisés dans le Piémont Cévenol, sont cultivés en bio.​<\/p><p>Localisation : Gard, France.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["image_dtQ7Kb","text_NRNmFm"],"custom_css":[],"name":"01 cultiver","settings":{"content_direction":"row","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"scheme-2","background_media":"none","video_position":"cover","background_image_position":"cover","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"toggle_overlay":false,"overlay_color":"#00000026","overlay_style":"solid","gradient_direction":"to top","padding-block-start":20,"padding-block-end":20}},"section_NpCfaM":{"type":"section","blocks":{"image_ewk9qp":{"type":"image","name":"t:names.image","settings":{"image":"shopify:\/\/shop_images\/graines.png","link":"","image_ratio":"adapt","width":"fit-content","custom_width":100,"width_mobile":"fit-content","custom_width_mobile":100,"height":"fit","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_6RY6VQ":{"type":"text","name":"t:names.text","settings":{"text":"<h2>2. Assembler les graines<\/h2><p>Une femelle Bombyx pond 500 œufs, aussi appelés \"graines\". Ils sont sélectionnés et assemblés en amont de l'élevage. Les souches de la soie SAINT LOUP sont choisies pour leur origine cévenole et leur excellence, mesurée à leur taux de soie.<\/p><p>Localisation : Gard, France.<\/p>","width":"100%","max_width":"none","alignment":"left","type_preset":"rte","font":"var(--font-body--family)","font_size":"1rem","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"var(--color-foreground)","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}}},"block_order":["image_ewk9qp","text_6RY6VQ"],"custom_css":[],"name":"02 assembler","settings":{"content_direction":"row","vertical_on_mobile":true,"horizontal_alignment":"flex-start","vertical_alignment":"center","align_baseline":false,"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":12,"section_width":"page-width","section_height":"","section_height_custom":50,"color_scheme":"scheme-2","background_media":"none","vid