nd_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":8,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_Upz3Mm":{"type":"text","name":"t:names.text","settings":{"text":"<p>Le Sud de la France nourrit des fantasmes d’abondance et de nature luxuriante. Les lavandes de Provence, les fruits gorgés de soleil, les plages des côtes Vermeille et d’Azur.​<\/p><p>Il existe un autre Sud. Rude, laborieux, retenu. Le Sud brut.<\/p><p>​Du Pic Saint Loup aux Cévennes, on trouve un pays de garrigue rocailleuse d'où jaillit un thym aux fleurs modestes, à l’ombre des mûriers dont on nourrissait les vers à soie.<\/p><p>A l’âge d’or de la soie, les paysans y portaient un <em>moucadou del col<\/em> (\"mouchoir de cou\" en occitan).<\/p>","width":"100%","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-primary--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"button_7X8VPi":{"type":"button","name":"t:names.button","settings":{"label":"Notre histoire","link":"shopify:\/\/pages\/histoire","open_in_new_tab":false,"style_class":"button","width":"fit-content","custom_width":100,"width_mobile":"fit-content","custom_width_mobile":100},"blocks":{}}},"block_order":["image_TDKC4T","text_zCLead","text_Upz3Mm","button_7X8VPi"]}},"name":"Editorial","settings":{"media_position":"left","media_width":"medium","media_height":"80svh","section_width":"full-width","extend_media":false,"color_scheme":"scheme-1","padding-block-start":0,"padding-block-end":0}},"media_with_content_8pDkAK":{"type":"media-with-content","blocks":{"media":{"type":"_media-without-appearance","static":true,"settings":{"media_type":"image","image":"shopify:\/\/shop_images\/saint-loup-notre-patrimonie.avif","link":"","video_loop":true,"video_autoplay":false,"image_position":"cover","video_position":"cover"},"blocks":{}},"content":{"type":"_content-without-appearance","static":true,"settings":{"horizontal_alignment_flex_direction_column":"flex-start","vertical_alignment_flex_direction_column":"center","gap":24},"blocks":{"image_J6QM84":{"type":"image","name":"t:names.image","settings":{"image":"shopify:\/\/shop_images\/motif.png","link":"","image_ratio":"adapt","width":"custom","custom_width":12,"width_mobile":"custom","custom_width_mobile":20,"height":"fit","border":"none","border_width":1,"border_opacity":100,"border_radius":0,"padding-block-start":35,"padding-block-end":0,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_njzRG3":{"type":"text","name":"t:names.heading","settings":{"text":"<h2>Ressuscitons notre patrimoine<\/h2>","width":"fit-content","max_width":"narrow","alignment":"left","type_preset":"rte","font":"var(--font-primary--family)","font_size":"","line_height":"normal","letter_spacing":"normal","case":"none","wrap":"pretty","color":"","background":false,"background_color":"#00000026","corner_radius":0,"padding-block-start":0,"padding-block-end":8,"padding-inline-start":0,"padding-inline-end":0},"blocks":{}},"text_LxqWGK":{"type":"text","name":"t:names.text","settings":{"text":"<p>L'héritage de la soie française ne tient qu'à un fil.<\/p><p>​​En 1853, la France produisait 26.000 tonnes de soie par an, dont la moitié des Cévennes jusqu’au Pic Saint Loup.<\/p><p>Puis la filière s'est éteinte dans le silence, à grands coups de délocalisations. La France s'est résignée à importer toute sa soie du bout du monde. <\/p><p>Jusqu'à la relance de la soie française par SAINT LOUP, issue de cocons cévenols.<\/p><p>Pour cette renaissance, il a suffi de deux papillons amoureux. Leur 500 œufs peuvent tisser 500 cocons. De quoi fabriquer un foulard.<\/p>","width":"fit-content","max_width":"normal","alignment":"left","type_preset":"rte","font":"var(--font-primary--fa