<section class="sl sl-hi-hero">
  {%- render 'sl-img', image: section.settings.image, fb: section.settings.image_fb, alt: section.settings.alt, loading: 'eager' -%}
  <div class="sl-shade"></div>
  <h1>{{ section.settings.heading }}</h1>
</section>

{% schema %}
{
  "name": "SL · Grande image titre",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_fb", "label": "Image par défaut (fichier du thème)", "default": "sl-hi-pic.jpg" },
    { "type": "text", "id": "alt", "label": "Texte alternatif", "default": "Le Pic Saint Loup dans les nuages" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Il était une soie" }
  ],
  "presets": [{ "name": "SL · Grande image titre" }]
}
{% endschema %}
