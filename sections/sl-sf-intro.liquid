<section class="sl sl-wrap sl-sf-intro">
  <div style="min-width:0">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.text }}</p>
  </div>
  {%- render 'sl-video', video: section.settings.video, fb: section.settings.video_fb, poster_fb: section.settings.poster_fb, label: section.settings.video_label -%}
</section>

{% schema %}
{
  "name": "SL · Savoir-faire intro",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Un savoir-faire unique en France, des mûriers jusqu'aux carrés" },
    { "type": "inline_richtext", "id": "text", "label": "Texte" },
    { "type": "video", "id": "video", "label": "Vidéo" },
    { "type": "text", "id": "video_fb", "label": "Vidéo par défaut (fichier du thème)", "default": "sl-sf-butterfly.mp4" },
    { "type": "text", "id": "poster_fb", "label": "Image d'attente par défaut (fichier du thème)", "default": "sl-sf-butterfly-poster.jpg" },
    { "type": "text", "id": "video_label", "label": "Description de la vidéo", "default": "Papillon de soie peint à la main" }
  ],
  "presets": [{ "name": "SL · Savoir-faire intro" }]
}
{% endschema %}
