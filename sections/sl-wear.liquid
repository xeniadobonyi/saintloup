<section class="sl sl-wrap sl-wear">
  <h2>{{ section.settings.heading }}</h2>
  {%- assign looks = section.blocks -%}
  {%- for block in looks -%}
    {%- assign p = block.settings.product -%}
    {%- capture fig -%}
      <figure class="sl-look {% if forloop.first %}sl-wide{% else %}sl-tall{% endif %}" {{ block.shopify_attributes }}>
        <div class="sl-frame">
          {%- render 'sl-img', image: block.settings.image, fb: block.settings.image_fb, alt: block.settings.alt, sizes: '(min-width: 700px) 50vw, 100vw' -%}
          {%- if p != blank -%}<a class="sl-tag" href="{{ p.url }}">{{ p.title }}<i aria-hidden="true"></i>{{ p.price | money_without_trailing_zeros }}</a>{%- endif -%}
        </div>
        {%- if block.settings.caption != blank -%}<figcaption>{{ block.settings.caption }}</figcaption>{%- endif -%}
      </figure>
    {%- endcapture -%}
    {%- if forloop.first -%}
      {{ fig }}
      {%- if looks.size > 1 -%}<div class="sl-pair">{%- endif -%}
    {%- else -%}
      {{ fig }}
      {%- if forloop.last -%}</div>{%- endif -%}
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "SL · Comment le porter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Comment le porter" }
  ],
  "blocks": [
    {
      "type": "look",
      "name": "Photo portée",
      "settings": [
        { "type": "paragraph", "content": "La première photo s'affiche en pleine largeur, les suivantes deux par deux." },
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_fb", "label": "Photo par défaut (fichier du thème)" },
        { "type": "text", "id": "alt", "label": "Texte alternatif" },
        { "type": "product", "id": "product", "label": "Produit (étiquette)" },
        { "type": "text", "id": "caption", "label": "Légende" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [{ "name": "SL · Comment le porter" }]
}
{% endschema %}
