{% doc %}
  @prompt
    Create a hero section with a smooth gradient transition overlay that includes a blurred reflection effect (frosted glass effect) in the gradient itself. The gradient should transition from transparent to the blurred effect, creating a seamless visual flow between the hero image and the section below it. The blur should be part of the gradient overlay, not just a separate layer.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-frosted-hero-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    overflow: hidden;
    display: block;
  }

  .ai-frosted-hero__image-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-frosted-hero__image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-frosted-hero__image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-frosted-hero__image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-frosted-hero__empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-frosted-hero__gradient-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .ai-frosted-hero__gradient-overlay-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      {{ block.settings.gradient_start_color }}00 0%,
      {{ block.settings.gradient_start_color }}{{ block.settings.gradient_opacity | divided_by: 100.0 | times: 255 | round | prepend: '0' | slice: -2, 2 }} {{ block.settings.gradient_start_position }}%,
      {{ block.settings.gradient_end_color }}{{ block.settings.gradient_opacity | divided_by: 100.0 | times: 255 | round | prepend: '0' | slice: -2, 2 }} 100%
    );
  }

  .ai-frosted-hero__gradient-overlay-{{ ai_gen_id }}::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent {{ block.settings.blur_start_position }}%,
      black {{ block.settings.blur_end_position }}%,
      black 100%
    );
    -webkit-mask-image: linear-gradient(
      to bottom,
      transparent 0%,
      transparent {{ block.settings.blur_start_position }}%,
      black {{ block.settings.blur_end_position }}%,
      black 100%
    );
  }

  .ai-frosted-hero__gradient-overlay-{{ ai_gen_id }}::after {
    backdrop-filter: blur({{ block.settings.blur_intensity }}px);
    -webkit-backdrop-filter: blur({{ block.settings.blur_intensity }}px);
  }

  .ai-frosted-hero__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    align-items: {{ block.settings.content_horizontal_alignment }};
    min-height: {{ block.settings.hero_height }}px;
    padding: 40px 20px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-frosted-hero__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    max-width: 800px;
  }

  .ai-frosted-hero__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 24px;
    max-width: 600px;
  }

  .ai-frosted-hero__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    transition: all 0.3s ease;
  }

  .ai-frosted-hero__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-frosted-hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.hero_height_mobile }}px;
    }

    .ai-frosted-hero__content-{{ ai_gen_id }} {
      min-height: {{ block.settings.hero_height_mobile }}px;
      padding: 30px 16px;
    }

    .ai-frosted-hero__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-frosted-hero__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<frosted-hero-{{ ai_gen_id }} class="ai-frosted-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-frosted-hero__image-wrapper-{{ ai_gen_id }}">
    {% if block.settings.hero_image %}
      <img
        src="{{ block.settings.hero_image | image_url: width: 2000 }}"
        alt="{{ block.settings.hero_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.hero_image.width }}"
        height="{{ block.settings.hero_image.height }}"
        class="ai-frosted-hero__image-{{ ai_gen_id }}"
      >
    {% else %}
      <div class="ai-frosted-hero__image-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-frosted-hero__empty-state-{{ ai_gen_id }}">
          Add a hero image to get started
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-frosted-hero__gradient-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-frosted-hero__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h1 class="ai-frosted-hero__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <p class="ai-frosted-hero__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
    {% endif %}

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <a href="{{ block.settings.button_link }}" class="ai-frosted-hero__button-{{ ai_gen_id }}">
        {{ block.settings.button_text }}
      </a>
    {% endif %}
  </div>
</frosted-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class FrostedHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('frosted-hero-{{ ai_gen_id }}', FrostedHero{{ ai_gen_id }});
  })();
</script>

{% schema %}
